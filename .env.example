# Copy to .env.local for `vercel dev` (never commit it). In production, set these in
# Vercel → Project → Settings → Environment Variables.

# The whole service-account JSON key (same one as the registrations dashboard is fine).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The "Pratikriti – Out House Referral Sheet": its full link or just its ID.
REFERRAL_SHEET=
